# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp

# IDE
.vscode/
.idea/
*.iml

# Build output (root only — don't match scripts/build/)
/bin/
/build/
/builds/
/exports/
*.apk
*.aab
*.ipa
*.pck
*.zip

# Keystore files (NEVER commit signing keys!)
*.keystore
*.jks
*.p12
*.mobileprovision

# User-specific Godot files
*.cfg.user

# Graphify tooling artifacts (regenerated)
graphify-out/
.graphify_staging/
.graphify_python

# Godot Android gradle build template (installed per machine)
/android/

# raw gameplay masters for store shots (180 MB, regenerate with ShotDirector)
assets/store/screenshots/master_gameplay/
__pycache__/
